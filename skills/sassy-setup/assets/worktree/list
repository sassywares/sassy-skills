#!/usr/bin/env bash
# Show every worktree of this repo: branch, path, whether its tree is dirty, and
# the upstream it tracks.
#
# Usage: .sassywares/worktree/list [--path <slug>] [--version]
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

usage() {
  cat <<'EOF'
Usage: .sassywares/worktree/list [--path <slug>]

Print every worktree with its branch, path, dirty state, and upstream.

  --path <slug>  print only the path of one worktree (for cd "$(...)")
EOF
}

want=""
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) printf '%s\n' "$WT_VERSION"; exit 0 ;;
    --path) shift; want="${1:-}"; [ -n "$want" ] || die "path needs a slug" ;;
    -*) die "unknown flag: $1 (try --help)" ;;
    *) die "unexpected argument: $1 (try --help)" ;;
  esac
  shift
done

need_git

if [ -n "$want" ]; then
  rec="$(wt_require_managed "$want")"
  path="${rec%%$'\t'*}"
  wt_is_main "$path" && die "the main checkout is not a worktree"
  printf '%s\n' "$path"
  exit 0
fi

printf '  %-34s %-50s %-6s %s\n' "BRANCH" "WORKTREE" "DIRTY" "UPSTREAM"
count=0
unmanaged=0
while IFS=$'\t' read -r p b; do
  [ -n "$p" ] || continue
  count=$(( count + 1 ))
  shown="${p/#$HOME/~}"
  label="$b"
  if wt_is_main "$p"; then
    label="$b (main checkout)"
  elif ! wt_managed "$p"; then
    # No git calls for a checkout that is not ours: it is counted, never listed.
    unmanaged=$(( unmanaged + 1 ))
    continue
  fi
  if wt_dirty "$p"; then dirty="yes"; else dirty="no"; fi
  up="$(wt_upstream "$p")"
  printf '  %-34s %-50s %-6s %s\n' "$(short_path "$label" 34)" "$(short_path "$shown" 50)" "$dirty" "${up:-—}"
done < <(wt_all)

[ "$count" -gt 0 ] || log "  no checkouts found — is this a git repository?"
[ "$unmanaged" -gt 0 ] && hint "$unmanaged worktree(s) not managed here — outside $(wt_home | sed "s|$HOME|~|"), or cut before the wiring"
true
