#!/usr/bin/env bash
# Add a worktree for one branch.
#
# Idempotent: a branch already in a worktree of ours is shown, not recreated,
# and nobody else's checkout holding it is a stop rather than a clobber.
#
# Usage: .sassywares/worktree/create <branch> [--from <start-point>] [--env]
#        .sassywares/worktree/create --version
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
# shellcheck source=./_lib.sh
source "$SCRIPT_DIR/_lib.sh"

usage() {
  cat <<'EOF'
Usage: .sassywares/worktree/create <branch> [--from <start-point>] [--env]

Create (or find) the worktree for <branch> and print the namespace a run
inherits: WT_PATH, WT_BRANCH, WT_SLUG, WT_NAMESPACE.

  --from <ref>  where a new branch is cut from (default HEAD). A caller that has
                already resolved the base passes it; this script never guesses.
  --env         print only `WT_*=<value>` lines, for eval.
EOF
}

branch=""
from="HEAD"
env_only=0
while [ $# -gt 0 ]; do
  case "$1" in
    -h|--help) usage; exit 0 ;;
    --version) printf '%s\n' "$WT_VERSION"; exit 0 ;;
    --env) env_only=1 ;;
    --from) shift; from="${1:-}"; [ -n "$from" ] || die "--from needs a start point" ;;
    --from=*) from="${1#*=}" ;;
    -*) die "unknown flag: $1 (try --help)" ;;
    *)  [ -z "$branch" ] || die "one branch at a time"; branch="$1" ;;
  esac
  shift
done
[ -n "$branch" ] || { usage >&2; exit 2; }

need_git
wt_enabled || die "worktrees are off here — set worktrees.enabled: true in .sassywares/config.yaml"

slug="$(wt_slug "$branch")"
path="$(wt_path "$slug")"

show() { # $1 path
  local ns
  ns="$(wt_namespace "$slug")"
  if [ "$env_only" -eq 1 ]; then
    printf 'WT_PATH=%s\nWT_BRANCH=%s\nWT_SLUG=%s\nWT_NAMESPACE=%s\n' "$1" "$branch" "$slug" "$ns"
    return 0
  fi
  ok worktree "$1"
  ok branch "$branch"
  # Say the tracking out loud. A branch cut from a remote-tracking ref used to
  # inherit it as its upstream, so a plain push aimed at the base; and a branch
  # that tracks something other than its own name is the state that made that
  # invisible. `create` never sets a base — it shows what it found.
  local up
  up="$(wt_upstream "$1")"
  ok upstream "${up:-none}"
  [ -z "$up" ] || [ "${up#*/}" = "$branch" ] \
    || warn upstream "this branch tracks '$up', not '$branch' — a plain 'git push' lands there"
  ok namespace "$ns"
  # A branch cut from a ref that predates setup has no config and no tooling, so
  # this checkout is not managed here: `list` skips it, `prune` leaves it alone.
  [ -f "$1/.sassywares/config.yaml" ] \
    || ok unmanaged "this branch has no .sassywares/config.yaml — cut from a ref that predates setup; list and prune will skip it"
  local hooks n
  hooks="$(wt_hook after_create "$branch")"
  if [ -z "$hooks" ]; then
    ok hook "hooks.worktree.after_create — none declared"
  else
    while IFS= read -r n; do
      [ -n "$n" ] || continue
      ok hook "after_create → $n (dispatch it, with WT_* above)"
    done <<<"$hooks"
  fi
}

# Already in a worktree of ours: show it and stop. This is the second call in a
# resumed run, and it must not fail.
existing="$(wt_find "$branch" || true)"
if [ -n "$existing" ]; then
  epath="${existing%%$'\t'*}"
  if wt_is_main "$epath"; then
    die "'$branch' is checked out in the main checkout — leave it, or switch the main checkout first"
  fi
  show "$epath"
  exit 0
fi

if [ -e "$path" ]; then
  die "'$path' exists but no worktree is registered for '$branch' — inspect it, then prune"
fi

home="$(wt_home)"
(umask 077; mkdir -p "$home")
printf '%s\n' "$MAIN" > "$home/.repo"

if git show-ref --verify --quiet "refs/heads/$branch"; then
  git worktree add --quiet "$path" "$branch"
else
  # --no-track is the whole point: without it git's DWIM gives a branch cut from
  # a remote-tracking ref that ref as its upstream, so the branch's own push
  # targets the base. A checkout is a branch of its own, not a follower.
  git worktree add --quiet --no-track -b "$branch" "$path" "$from"
fi

show "$path"
